#!/bin/sh
# "Desktop link" choice of AutoClicker-Setup.pkg: puts a link named
# AutoClicker on the Desktop of the user it acts for (see common.sh).
. "$(dirname "$0")/common.sh"

link="$USER_HOME/Desktop/AutoClicker"
# Never replace something of the user's that happens to have this name; only
# a link to an AutoClicker.app, made by an earlier install.
if [ -L "$link" ]; then
    case $(readlink "$link") in
        */AutoClicker.app | */AutoClicker.app/) ;;
        *) log "$link links to something else; leaving it"; exit 0 ;;
    esac
elif [ -e "$link" ]; then
    log "$link already exists; leaving it"
    exit 0
fi
if as_user ln -sfn "$APP" "$link"; then
    log "linked $link to $APP"
else
    log "couldn't make $link"
fi
exit 0
